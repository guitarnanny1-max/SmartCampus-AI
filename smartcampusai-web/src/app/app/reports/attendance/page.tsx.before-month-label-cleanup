"use client";

import { useEffect, useMemo, useState } from "react";

type AttendanceStatus =
  | "PRESENT"
  | "ABSENT"
  | "LATE"
  | "HALF_DAY"
  | "LEAVE";

type ReportRecord = {
  id: string;
  personId: string;
  personName: string;
  role: "Teacher" | "Student";
  date: string;
  status: AttendanceStatus;
  classId?: string | null;
  sectionId?: string | null;
  subjectId?: string | null;
  periodNumber?: number | null;
  classPeriodAttendanceId?: string | null;
};

type Summary = {
  total: number;
  present: number;
  absent: number;
  late: number;
  halfDay: number;
  leave: number;
  attendanceRate: number;
};

type MonthlyStudent = {
  studentId: string;
  studentName: string;
  days: Record<string, AttendanceStatus[]>;
  attendanceRate: number;
};

type AcademicYearOption = {
  id: string;
  name: string;
  start_date?: string | null;
  end_date?: string | null;
  status?: string | null;
};

type ClassOption = {
  id: string;
  name: string;
};

type SectionOption = {
  id: string;
  name: string;
  class_id: string;
};

type StudentOption = {
  id: string;
  name: string | null;
};

type StudentEnrollment = {
  student_id: string;
  academic_year_id: string | null;
  class_id: string | null;
  section_id: string | null;
  status?: string | null;
};

function today() {
  return new Date().toISOString().slice(0, 10);
}

function formatDate(value: string) {
  if (!value) return "—";

  const date = new Date(`${value}T00:00:00`);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

export default function AttendanceReportsPage() {
  const [from, setFrom] = useState(today());
  const [to, setTo] = useState(today());

  const [academicYears, setAcademicYears] =
    useState<AcademicYearOption[]>([]);
  const [academicYearId, setAcademicYearId] =
    useState("");

  const [classes, setClasses] = useState<ClassOption[]>([]);
  const [sections, setSections] = useState<SectionOption[]>([]);
  const [students, setStudents] = useState<StudentOption[]>([]);
  const [studentsLoading, setStudentsLoading] =
    useState(false);

  const [classId, setClassId] = useState("");
  const [sectionId, setSectionId] = useState("");
  const [studentId, setStudentId] = useState("");

  const [records, setRecords] = useState<ReportRecord[]>([]);
  const [summary, setSummary] = useState<Summary>({
    total: 0,
    present: 0,
    absent: 0,
    late: 0,
    halfDay: 0,
    leave: 0,
    attendanceRate: 0,
  });

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    let cancelled = false;

    async function loadAcademicYears() {
      try {
        const response = await fetch(
          "/api/academic-years",
          {
            credentials: "include",
            cache: "no-store",
          },
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(
            data?.error ||
              "Unable to load academic years.",
          );
        }

        if (!cancelled) {
          const years: AcademicYearOption[] =
            data.academicYears ?? [];

          setAcademicYears(years);

          const activeYear =
            years.find(
              (year) => year.status === "ACTIVE",
            ) ?? years[0];

          if (activeYear) {
            setAcademicYearId(activeYear.id);
          }
        }
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load academic years.",
          );
        }
      }
    }

    loadAcademicYears();

    return () => {
      cancelled = true;
    };
  }, []);

  useEffect(() => {
    let cancelled = false;

    async function loadClasses() {
      try {
        const response = await fetch("/api/classes", {
          credentials: "include",
          cache: "no-store",
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data?.error || "Unable to load classes.");
        }

        if (!cancelled) {
          setClasses(
            (data.classes ?? []).map((item: any) => ({
              id: item.id,
              name: item.name,
            })),
          );
        }
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load classes.",
          );
        }
      }
    }

    loadClasses();

    return () => {
      cancelled = true;
    };
  }, []);

  useEffect(() => {
    let cancelled = false;

    async function loadSections() {
      setSections([]);
      setSectionId("");

      if (!classId) return;

      try {
        const response = await fetch(
          `/api/sections?class_id=${encodeURIComponent(classId)}`,
          {
            credentials: "include",
            cache: "no-store",
          },
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(
            data?.error || "Unable to load sections.",
          );
        }

        if (!cancelled) {
          setSections(
            (data.sections ?? []).filter(
              (item: SectionOption) =>
                item.class_id === classId,
            ),
          );
        }
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load sections.",
          );
        }
      }
    }

    loadSections();

    return () => {
      cancelled = true;
    };
  }, [classId]);

  useEffect(() => {
    let cancelled = false;

    async function loadStudentsForContext() {
      setStudents([]);
      setStudentId("");

      if (!academicYearId) return;

      setStudentsLoading(true);

      try {
        const params = new URLSearchParams({
          academic_year_id: academicYearId,
        });

        if (classId) {
          params.set("class_id", classId);
        }

        if (sectionId) {
          params.set("section_id", sectionId);
        }

        const response = await fetch(
          `/api/student-enrollments?${params.toString()}`,
          {
            credentials: "include",
            cache: "no-store",
          },
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(
            data?.error ||
              "Unable to load enrolled students.",
          );
        }

        const enrollments: StudentEnrollment[] =
          data.enrollments ?? [];

        const activeEnrollments =
          enrollments.filter(
            (item) =>
              !item.status ||
              item.status === "ACTIVE",
          );

        const uniqueStudentIds = Array.from(
          new Set(
            activeEnrollments.map(
              (item) => item.student_id,
            ),
          ),
        );

        if (uniqueStudentIds.length === 0) {
          if (!cancelled) {
            setStudents([]);
          }
          return;
        }

        const studentsResponse = await fetch(
          "/api/students",
          {
            credentials: "include",
            cache: "no-store",
          },
        );

        const studentsData =
          await studentsResponse.json();

        if (!studentsResponse.ok) {
          throw new Error(
            studentsData?.error ||
              "Unable to load students.",
          );
        }

        const studentMap = new Map<string, StudentOption>(
          (studentsData.students ?? []).map(
            (item: any) => [
              item.id,
              {
                id: item.id,
                name: item.name ?? null,
              },
            ],
          ),
        );

        const contextualStudents =
          uniqueStudentIds
            .map((id) => studentMap.get(id))
            .filter(
              (item): item is StudentOption =>
                Boolean(item),
            )
            .sort((a, b) =>
              (a.name ?? a.id).localeCompare(
                b.name ?? b.id,
              ),
            );

        if (!cancelled) {
          setStudents(contextualStudents);
        }
      } catch (err) {
        if (!cancelled) {
          setStudents([]);
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load enrolled students.",
          );
        }
      } finally {
        if (!cancelled) {
          setStudentsLoading(false);
        }
      }
    }

    loadStudentsForContext();

    return () => {
      cancelled = true;
    };
  }, [academicYearId, classId, sectionId]);

  function exportCsv() {
    if (records.length === 0) return;

    const escapeCsv = (value: unknown) => {
      const text = String(value ?? "");

      if (
        text.includes(",") ||
        text.includes('"') ||
        text.includes("\n")
      ) {
        return `"${text.replace(/"/g, '""')}"`;
      }

      return text;
    };

    const className =
      classes.find((item) => item.id === classId)?.name ??
      "";

    const sectionName =
      sections.find((item) => item.id === sectionId)?.name ??
      "";

    const rows = [
      [
        "Student",
        "Date",
        "Status",
        "Class",
        "Section",
        "Subject",
        "Period",
        "Attendance %",
      ],
      ...records
        .filter(
          (record) => record.role === "Student",
        )
        .map((record) => {
          const subjectName =
            record.subjectId
              ? records.find(
                  (item) =>
                    item.subjectId ===
                      record.subjectId &&
                    item.role === "Student",
                )?.subjectId ?? record.subjectId
              : "";

          return [
            record.personName,
            record.date,
            record.status,
            className ||
              (record.classId ?? ""),
            sectionName ||
              (record.sectionId ?? ""),
            subjectName,
            record.periodNumber ?? "",
            studentSummaries.find(
              (student) =>
                student.studentId ===
                record.personId,
            )?.attendanceRate ?? "",
          ];
        }),
    ];

    const csv = rows
      .map((row) =>
        row.map(escapeCsv).join(","),
      )
      .join("\r\n");

    const blob = new Blob([csv], {
      type: "text/csv;charset=utf-8;",
    });

    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");

    anchor.href = url;
    anchor.download = `attendance-report-${from}-to-${to}.csv`;

    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();

    URL.revokeObjectURL(url);
  }

  function printReport() {
    if (records.length === 0) return;
    window.print();
  }

  async function runReport() {
    setLoading(true);
    setError("");

    try {
      if (!from || !to) {
        throw new Error("Select both start and end dates.");
      }

      if (from > to) {
        throw new Error(
          "Start date cannot be after end date.",
        );
      }

      const params = new URLSearchParams({
        from,
        to,
      });

      if (academicYearId) {
        params.set(
          "academic_year_id",
          academicYearId,
        );
      }

      if (classId) {
        params.set("class_id", classId);
      }

      if (sectionId) {
        params.set("section_id", sectionId);
      }

      if (studentId) {
        params.set("student_id", studentId);
      }

      const response = await fetch(
        `/api/attendance?${params.toString()}`,
        {
          credentials: "include",
          cache: "no-store",
        },
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data?.error || "Unable to load attendance report.",
        );
      }

      const nextRecords: ReportRecord[] =
        (data.records ?? []).filter(
          (item: ReportRecord) =>
            item.role === "Student",
        );

      const presentCount = nextRecords.filter(
        (item) => item.status === "PRESENT",
      ).length;

      const nextSummary = {
        total: nextRecords.length,
        present: presentCount,
        absent: nextRecords.filter(
          (item) => item.status === "ABSENT",
        ).length,
        late: nextRecords.filter(
          (item) => item.status === "LATE",
        ).length,
        halfDay: nextRecords.filter(
          (item) => item.status === "HALF_DAY",
        ).length,
        leave: nextRecords.filter(
          (item) => item.status === "LEAVE",
        ).length,
        attendanceRate:
          nextRecords.length > 0
            ? Math.round(
                (presentCount /
                  nextRecords.length) *
                  100,
              )
            : 0,
      };

      setRecords(nextRecords);
      setSummary(nextSummary);
    } catch (err) {
      setRecords([]);
      setSummary({
        total: 0,
        present: 0,
        absent: 0,
        late: 0,
        halfDay: 0,
        leave: 0,
        attendanceRate: 0,
      });

      setError(
        err instanceof Error
          ? err.message
          : "Unable to load attendance report.",
      );
    } finally {
      setLoading(false);
    }
  }

  const studentSummaries = useMemo(() => {
    const map = new Map<
      string,
      {
        studentId: string;
        studentName: string;
        total: number;
        present: number;
        absent: number;
        late: number;
        leave: number;
        attendanceRate: number;
      }
    >();

    for (const record of records) {
      if (record.role !== "Student") continue;

      const existing = map.get(record.personId) ?? {
        studentId: record.personId,
        studentName: record.personName,
        total: 0,
        present: 0,
        absent: 0,
        late: 0,
        leave: 0,
        attendanceRate: 0,
      };

      existing.total += 1;

      if (record.status === "PRESENT") existing.present += 1;
      if (record.status === "ABSENT") existing.absent += 1;
      if (record.status === "LATE") existing.late += 1;
      if (record.status === "LEAVE") existing.leave += 1;

      existing.attendanceRate =
        existing.total > 0
          ? Math.round(
              (existing.present / existing.total) *
                100,
            )
          : 0;

      map.set(record.personId, existing);
    }

    return Array.from(map.values()).sort((a, b) =>
      a.studentName.localeCompare(b.studentName),
    );
  }, [records]);

  const monthlyStudents = useMemo<MonthlyStudent[]>(() => {
    const map = new Map<string, MonthlyStudent>();

    for (const record of records) {
      if (record.role !== "Student") continue;

      const existing = map.get(record.personId) ?? {
        studentId: record.personId,
        studentName: record.personName,
        days: {},
        attendanceRate: 0,
      };

      const day = record.date;

      if (!existing.days[day]) {
        existing.days[day] = [];
      }

      existing.days[day].push(record.status);

      map.set(record.personId, existing);
    }

    for (const student of map.values()) {
      let totalSessions = 0;
      let presentSessions = 0;

      for (const statuses of Object.values(student.days)) {
        for (const status of statuses) {
          totalSessions += 1;
          if (status === "PRESENT") {
            presentSessions += 1;
          }
        }
      }

      student.attendanceRate =
        totalSessions > 0
          ? Math.round(
              (presentSessions / totalSessions) * 100,
            )
          : 0;
    }

    return Array.from(map.values()).sort((a, b) =>
      a.studentName.localeCompare(b.studentName),
    );
  }, [records]);

  const reportDays = useMemo(() => {
    const days = new Set<string>();

    for (const record of records) {
      if (record.role === "Student") {
        days.add(record.date);
      }
    }

    return Array.from(days).sort();
  }, [records]);

  function monthlyStatusCode(statuses?: AttendanceStatus[]) {
    if (!statuses || statuses.length === 0) return "—";

    if (statuses.includes("PRESENT")) return "P";
    if (statuses.includes("LATE")) return "L";
    if (statuses.includes("HALF_DAY")) return "H";
    if (statuses.includes("LEAVE")) return "LV";
    if (statuses.includes("ABSENT")) return "A";

    return "—";
  }

  const classAnalytics = useMemo(() => {
    const students = studentSummaries;

    const totalStudents = students.length;
    const totalSessions = students.reduce(
      (sum, student) => sum + student.total,
      0,
    );
    const totalPresent = students.reduce(
      (sum, student) => sum + student.present,
      0,
    );
    const totalAbsent = students.reduce(
      (sum, student) => sum + student.absent,
      0,
    );
    const totalLate = students.reduce(
      (sum, student) => sum + student.late,
      0,
    );
    const totalLeave = students.reduce(
      (sum, student) => sum + student.leave,
      0,
    );

    const attendanceRate =
      totalSessions > 0
        ? Math.round(
            (totalPresent / totalSessions) * 100,
          )
        : 0;

    const lowAttendanceStudents = students
      .filter(
        (student) =>
          student.total > 0 &&
          student.attendanceRate < 75,
      )
      .sort(
        (a, b) =>
          a.attendanceRate - b.attendanceRate,
      );

    return {
      totalStudents,
      totalSessions,
      totalPresent,
      totalAbsent,
      totalLate,
      totalLeave,
      attendanceRate,
      lowAttendanceStudents,
    };
  }, [studentSummaries]);

  const monthlyTrends = useMemo(() => {
    const map = new Map<
      string,
      {
        month: string;
        total: number;
        present: number;
        absent: number;
        late: number;
        halfDay: number;
        leave: number;
        attendanceRate: number;
      }
    >();

    for (const record of records) {
      if (record.role !== "Student") continue;

      const month = record.date.slice(0, 7);

      const existing = map.get(month) ?? {
        month,
        total: 0,
        present: 0,
        absent: 0,
        late: 0,
        halfDay: 0,
        leave: 0,
        attendanceRate: 0,
      };

      existing.total += 1;

      if (record.status === "PRESENT") {
        existing.present += 1;
      }

      if (record.status === "ABSENT") {
        existing.absent += 1;
      }

      if (record.status === "LATE") {
        existing.late += 1;
      }

      if (record.status === "HALF_DAY") {
        existing.halfDay += 1;
      }

      if (record.status === "LEAVE") {
        existing.leave += 1;
      }

      existing.attendanceRate =
        existing.total > 0
          ? Math.round(
              (existing.present /
                existing.total) *
                100,
            )
          : 0;

      map.set(month, existing);
    }

    return Array.from(map.values()).sort((a, b) =>
      a.month.localeCompare(b.month),
    );
  }, [records]);

  const trendStats = useMemo(() => {
    if (monthlyTrends.length === 0) {
      return {
        current: null as number | null,
        previous: null as number | null,
        change: null as number | null,
      };
    }

    const current =
      monthlyTrends[monthlyTrends.length - 1]
        .attendanceRate;

    const previous =
      monthlyTrends.length > 1
        ? monthlyTrends[monthlyTrends.length - 2]
            .attendanceRate
        : null;

    return {
      current,
      previous,
      change:
        previous !== null
          ? current - previous
          : null,
    };
  }, [monthlyTrends]);

  return (
    <main className="space-y-6 p-5 sm:p-6 lg:p-8">
      <div>
        <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">
          Intelligence
        </p>
        <h1 className="mt-1 text-2xl font-semibold text-slate-950">
          Attendance Reports
        </h1>
        <p className="mt-1 text-sm text-slate-500">
          Analyze attendance across dates, classes,
          sections and students.
        </p>
      </div>

      <section className="print:hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div className="grid gap-4 md:grid-cols-6">
          <div>
            <label className="mb-1.5 block text-sm font-semibold text-slate-700">
              Academic Year
            </label>
            <select
              value={academicYearId}
              onChange={(event) =>
                setAcademicYearId(
                  event.target.value,
                )
              }
              className="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
            >
              <option value="">
                All Academic Years
              </option>
              {academicYears.map((year) => (
                <option
                  key={year.id}
                  value={year.id}
                >
                  {year.name}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="mb-1.5 block text-sm font-semibold text-slate-700">
              Date From
            </label>
            <input
              type="date"
              value={from}
              onChange={(event) =>
                setFrom(event.target.value)
              }
              className="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
            />
          </div>

          <div>
            <label className="mb-1.5 block text-sm font-semibold text-slate-700">
              Date To
            </label>
            <input
              type="date"
              value={to}
              onChange={(event) =>
                setTo(event.target.value)
              }
              className="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
            />
          </div>

          <div>
            <label className="mb-1.5 block text-sm font-semibold text-slate-700">
              Class
            </label>
            <select
              value={classId}
              onChange={(event) =>
                setClassId(event.target.value)
              }
              className="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
            >
              <option value="">All Classes</option>
              {classes.map((item) => (
                <option key={item.id} value={item.id}>
                  {item.name}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="mb-1.5 block text-sm font-semibold text-slate-700">
              Section
            </label>
            <select
              value={sectionId}
              onChange={(event) =>
                setSectionId(event.target.value)
              }
              disabled={!classId}
              className="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm disabled:bg-slate-50"
            >
              <option value="">All Sections</option>
              {sections.map((item) => (
                <option key={item.id} value={item.id}>
                  {item.name}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="mb-1.5 block text-sm font-semibold text-slate-700">
              Student
            </label>
            <select
              value={studentId}
              onChange={(event) =>
                setStudentId(event.target.value)
              }
              disabled={studentsLoading}
              className="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm disabled:bg-slate-50"
            >
              <option value="">All Students</option>
              {students.map((item) => (
                <option key={item.id} value={item.id}>
                  {item.name ?? item.id}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div className="mt-5 flex flex-wrap justify-end gap-3">
          <button
            type="button"
            onClick={printReport}
            disabled={
              loading || records.length === 0
            }
            className="print:hidden rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Print Report
          </button>

          <button
            type="button"
            onClick={exportCsv}
            disabled={
              loading || records.length === 0
            }
            className="print:hidden rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Export CSV
          </button>

          <button
            type="button"
            onClick={runReport}
            disabled={loading}
            className="print:hidden rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50"
          >
            {loading ? "Loading..." : "Run Report"}
          </button>
        </div>
      </section>

      {error && (
        <section className="rounded-2xl border border-red-200 bg-red-50 p-5">
          <p className="text-sm font-semibold text-red-800">
            Unable to load attendance report
          </p>
          <p className="mt-1 text-sm text-red-700">
            {error}
          </p>
        </section>
      )}

      <section>
        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {[
            ["Total Sessions", summary.total],
            ["Present", summary.present],
            ["Absent", summary.absent],
            ["Late", summary.late],
            ["Attendance", `${summary.attendanceRate}%`],
          ].map(([label, value]) => (
            <div
              key={label}
              className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
            >
              <p className="text-xs font-semibold uppercase tracking-wide text-slate-400">
                {label}
              </p>
              <p className="mt-2 text-2xl font-semibold text-slate-950">
                {value}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section className="space-y-4">
        <div>
          <h2 className="text-base font-semibold text-slate-950">
            Class-wise Attendance Analytics
          </h2>
          <p className="mt-1 text-sm text-slate-500">
            Summary of attendance performance for the selected report context.
          </p>
        </div>

        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
          {[
            ["Students", classAnalytics.totalStudents],
            ["Sessions", classAnalytics.totalSessions],
            ["Present", classAnalytics.totalPresent],
            ["Absent", classAnalytics.totalAbsent],
            ["Late", classAnalytics.totalLate],
            [
              "Attendance",
              `${classAnalytics.attendanceRate}%`,
            ],
          ].map(([label, value]) => (
            <div
              key={label}
              className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
            >
              <p className="text-xs font-semibold uppercase tracking-wide text-slate-400">
                {label}
              </p>
              <p className="mt-2 text-2xl font-semibold text-slate-950">
                {value}
              </p>
            </div>
          ))}
        </div>

        {classAnalytics.lowAttendanceStudents.length > 0 && (
          <div className="rounded-2xl border border-amber-200 bg-amber-50 shadow-sm">
            <div className="border-b border-amber-200 p-5">
              <h3 className="text-sm font-semibold text-amber-950">
                Low Attendance Alerts
              </h3>
              <p className="mt-1 text-xs text-amber-800">
                Students below 75% attendance in the selected report period.
              </p>
            </div>

            <div className="divide-y divide-amber-100">
              {classAnalytics.lowAttendanceStudents.map(
                (student) => (
                  <div
                    key={student.studentId}
                    className="flex items-center justify-between gap-4 p-4"
                  >
                    <div>
                      <p className="text-sm font-semibold text-slate-900">
                        {student.studentName}
                      </p>
                      <p className="mt-0.5 text-xs text-slate-500">
                        {student.present} present ·{" "}
                        {student.absent} absent ·{" "}
                        {student.total} sessions
                      </p>
                    </div>

                    <span className="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800">
                      {student.attendanceRate}%
                    </span>
                  </div>
                ),
              )}
            </div>
          </div>
        )}
      </section>

      <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div className="border-b border-slate-200 p-5">
          <h2 className="text-base font-semibold text-slate-950">
            Monthly Attendance Trends
          </h2>
          <p className="mt-1 text-sm text-slate-500">
            Attendance performance grouped by attendance month for the selected report scope.
          </p>
        </div>

        {monthlyTrends.length === 0 ? (
          <div className="p-8 text-center text-sm text-slate-500">
            Run the report to see monthly attendance trends.
          </div>
        ) : (
          <>
            <div className="grid gap-4 p-5 sm:grid-cols-3">
              <div className="rounded-xl border border-slate-200 p-4">
                <p className="text-xs font-semibold uppercase tracking-wide text-slate-400">
                  Current Month
                </p>
                <p className="mt-2 text-2xl font-semibold text-slate-950">
                  {trendStats.current}%
                </p>
              </div>

              <div className="rounded-xl border border-slate-200 p-4">
                <p className="text-xs font-semibold uppercase tracking-wide text-slate-400">
                  Previous Month
                </p>
                <p className="mt-2 text-2xl font-semibold text-slate-950">
                  {trendStats.previous !== null
                    ? `${trendStats.previous}%`
                    : "—"}
                </p>
              </div>

              <div className="rounded-xl border border-slate-200 p-4">
                <p className="text-xs font-semibold uppercase tracking-wide text-slate-400">
                  Month-over-Month
                </p>
                <p className="mt-2 text-2xl font-semibold text-slate-950">
                  {trendStats.change !== null
                    ? `${trendStats.change > 0 ? "+" : ""}${trendStats.change}%`
                    : "—"}
                </p>
              </div>
            </div>

            <div className="border-t border-slate-200 p-5">
              <div className="flex h-64 items-end gap-3 overflow-x-auto">
                {monthlyTrends.map((item) => (
                  <div
                    key={item.month}
                    className="flex min-w-16 flex-1 flex-col items-center gap-2"
                  >
                    <div className="flex h-44 w-full items-end">
                      <div
                        className="flex w-full items-start justify-center rounded-t-lg bg-slate-900 transition-all"
                        style={{
                          height: `${Math.max(
                            item.attendanceRate,
                            2,
                          )}%`,
                        }}
                        title={`${item.attendanceRate}% attendance`}
                      >
                        {item.attendanceRate >= 15 && (
                          <span className="pt-1 text-[10px] font-bold text-white">
                            {item.attendanceRate}%
                          </span>
                        )}
                      </div>
                    </div>

                    <div className="text-center text-xs font-medium text-slate-500">
                      {new Date(
                        `${item.month}-01T00:00:00`,
                      ).toLocaleDateString("en-IN", {
                        month: "short",
                        year: "numeric",
                      })}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div className="border-t border-slate-200">
              <div className="overflow-x-auto">
                <table className="min-w-full text-left text-sm">
                  <thead className="border-b border-slate-200 bg-slate-50">
                    <tr>
                      <th className="px-5 py-3 font-semibold">
                        Month
                      </th>
                      <th className="px-5 py-3 font-semibold">
                        Sessions
                      </th>
                      <th className="px-5 py-3 font-semibold">
                        Present
                      </th>
                      <th className="px-5 py-3 font-semibold">
                        Absent
                      </th>
                      <th className="px-5 py-3 font-semibold">
                        Late
                      </th>
                      <th className="px-5 py-3 font-semibold">
                        Leave
                      </th>
                      <th className="px-5 py-3 font-semibold">
                        Attendance %
                      </th>
                    </tr>
                  </thead>

                  <tbody>
                    {monthlyTrends.map((item) => {
                      const monthLabel =
                        new Date(
                          `${item.month}-01T00:00:00`,
                        ).toLocaleDateString("en-IN", {
                          month: "short",
                          year: "numeric",
                        });

                      return (
                        <tr
                          key={item.month}
                          className="border-b border-slate-100 last:border-0"
                        >
                          <td className="px-5 py-4 font-semibold text-slate-900">
                            {monthLabel}
                          </td>
                          <td className="px-5 py-4">
                            {item.total}
                          </td>
                          <td className="px-5 py-4">
                            {item.present}
                          </td>
                          <td className="px-5 py-4">
                            {item.absent}
                          </td>
                          <td className="px-5 py-4">
                            {item.late}
                          </td>
                          <td className="px-5 py-4">
                            {item.leave}
                          </td>
                          <td className="px-5 py-4 font-semibold">
                            {item.attendanceRate}%
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          </>
        )}
      </section>

      <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div className="flex flex-col gap-2 border-b border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 className="text-base font-semibold text-slate-950">
              Monthly Attendance Matrix
            </h2>
            <p className="mt-1 text-sm text-slate-500">
              One cell represents the recorded attendance sessions for that student on that date.
            </p>
          </div>

          <div className="flex flex-wrap gap-3 text-xs font-semibold text-slate-500">
            <span>P = Present</span>
            <span>A = Absent</span>
            <span>L = Late</span>
            <span>H = Half Day</span>
            <span>LV = Leave</span>
          </div>
        </div>

        {monthlyStudents.length === 0 ? (
          <div className="p-8 text-center text-sm text-slate-500">
            Run the report to see the monthly attendance matrix.
          </div>
        ) : reportDays.length === 0 ? (
          <div className="p-8 text-center text-sm text-slate-500">
            No attendance dates found for this report.
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="min-w-max text-left text-xs">
              <thead className="border-b border-slate-200 bg-slate-50">
                <tr>
                  <th className="sticky left-0 z-10 min-w-48 bg-slate-50 px-4 py-3 font-semibold">
                    Student
                  </th>

                  {reportDays.map((day) => (
                    <th
                      key={day}
                      className="px-3 py-3 text-center font-semibold"
                    >
                      <div>
                        {new Date(
                          `${day}T00:00:00`,
                        ).getDate()}
                      </div>
                      <div className="text-[10px] font-medium text-slate-400">
                        {new Date(
                          `${day}T00:00:00`,
                        ).toLocaleDateString(
                          "en-IN",
                          {
                            weekday: "short",
                          },
                        )}
                      </div>
                    </th>
                  ))}

                  <th className="px-4 py-3 text-center font-semibold">
                    %
                  </th>
                </tr>
              </thead>

              <tbody>
                {monthlyStudents.map((student) => (
                  <tr
                    key={student.studentId}
                    className="border-b border-slate-100 last:border-0"
                  >
                    <td className="sticky left-0 z-10 bg-white px-4 py-3 font-semibold text-slate-900">
                      {student.studentName}
                    </td>

                    {reportDays.map((day) => {
                      const statuses =
                        student.days[day];

                      return (
                        <td
                          key={`${student.studentId}-${day}`}
                          className="px-3 py-3 text-center font-semibold text-slate-700"
                          title={
                            statuses?.length
                              ? statuses.join(", ")
                              : "No attendance recorded"
                          }
                        >
                          {monthlyStatusCode(
                            statuses,
                          )}
                        </td>
                      );
                    })}

                    <td className="px-4 py-3 text-center font-semibold text-slate-900">
                      {student.attendanceRate}%
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div className="border-b border-slate-200 p-5">
          <h2 className="text-base font-semibold text-slate-950">
            Student Attendance
          </h2>
          <p className="mt-1 text-sm text-slate-500">
            {formatDate(from)} → {formatDate(to)}
          </p>
        </div>

        {studentSummaries.length === 0 ? (
          <div className="p-8 text-center text-sm text-slate-500">
            No student attendance records found.
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="min-w-full text-left text-sm">
              <thead className="border-b border-slate-200 bg-slate-50">
                <tr>
                  <th className="px-5 py-3 font-semibold">
                    Student
                  </th>
                  <th className="px-5 py-3 font-semibold">
                    Sessions
                  </th>
                  <th className="px-5 py-3 font-semibold">
                    Present
                  </th>
                  <th className="px-5 py-3 font-semibold">
                    Absent
                  </th>
                  <th className="px-5 py-3 font-semibold">
                    Late
                  </th>
                  <th className="px-5 py-3 font-semibold">
                    Leave
                  </th>
                  <th className="px-5 py-3 font-semibold">
                    Attendance %
                  </th>
                </tr>
              </thead>

              <tbody>
                {studentSummaries.map((student) => (
                  <tr
                    key={student.studentId}
                    className="border-b border-slate-100 last:border-0"
                  >
                    <td className="px-5 py-4 font-semibold text-slate-900">
                      {student.studentName}
                    </td>
                    <td className="px-5 py-4">
                      {student.total}
                    </td>
                    <td className="px-5 py-4">
                      {student.present}
                    </td>
                    <td className="px-5 py-4">
                      {student.absent}
                    </td>
                    <td className="px-5 py-4">
                      {student.late}
                    </td>
                    <td className="px-5 py-4">
                      {student.leave}
                    </td>
                    <td className="px-5 py-4 font-semibold">
                      {student.attendanceRate}%
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <p className="text-xs text-slate-400">
        Powered by ThomasG Technologies · SmartCampusAI
      </p>
    </main>
  );
}
