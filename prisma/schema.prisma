generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                               String                             @id @default(cuid())
  subdomain                        String                             @unique
  name                             String
  plan                             String                             @default("standard")
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
  status                           String                             @default("PENDING_PAYMENT")
  paymentStatus                    String                             @default("UNVERIFIED")
  onboardingStatus                 String                             @default("PENDING")
  contactEmail                     String?
  contactPhone                     String?
  schoolType                       String?
  studentCount                     Int?
  activatedAt                      DateTime?                          @db.Timestamp(6)
  verifiedAt                       DateTime?                          @db.Timestamp(6)
  attendances                      Attendance[]
  busLocations                     BusLocation[]
  invoices                         Invoice[]
  messages                         Message[]
  payments                         Payment[]
  PlatformCustomBill               PlatformCustomBill[]
  students                         Student[]
  Subscription                     Subscription[]
  users                            User[]
  academic_years                   academic_years[]
  attendance_approval_audit        attendance_approval_audit[]
  attendance_approvals             attendance_approvals[]
  class_period_attendance          class_period_attendance[]
  class_period_attendance_students class_period_attendance_students[]
  class_subjects                   class_subjects[]
  classes                          classes[]
  crm_lead_activities              crm_lead_activities[]
  crm_leads                        crm_leads[]
  exam_subjects                    exam_subjects[]
  exams                            exams[]
  fee_discounts                    fee_discounts[]
  fee_payment_allocations          fee_payment_allocations[]
  fee_payments                     fee_payments[]
  fee_receipts                     fee_receipts[]
  fee_structures                   fee_structures[]
  fee_types                        fee_types[]
  grading_scales                   grading_scales[]
  period_timings                   period_timings[]
  platform_crm_leads               platform_crm_leads[]
  section_subjects                 section_subjects[]
  sections                         sections[]
  student_enrollments              student_enrollments[]
  student_fee_discounts            student_fee_discounts[]
  student_fees                     student_fees[]
  student_guardians                student_guardians[]
  student_marks                    student_marks[]
  student_profiles                 student_profiles[]
  subjects                         subjects[]
  teacher_attendance               teacher_attendance[]
  timetables                       timetables[]
  student_consents                 StudentConsent[]
  parent_student_links             ParentStudentLink[]
}

model User {
  id                String              @id @default(cuid())
  tenantId          String?
  email             String              @unique
  name              String
  role              String
  password          String
  createdAt         DateTime            @default(now())
  platformRole      String?
  isPlatformUser    Boolean             @default(false)
  authVersion       Int                 @default(1)
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fee_payments      fee_payments[]
  ParentStudentLink ParentStudentLink[]
  platformOtps      PlatformOtp[]
}

model Student {
  id                               String                             @id @default(cuid())
  tenantId                         String
  name                             String
  rollNumber                       String                             @default("")
  grade                            String                             @default("")
  parentEmail                      String                             @default("")
  status                           String                             @default("ACTIVE")
  createdAt                        DateTime                           @default(now())
  Attendance                       Attendance[]
  tenant                           Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class_period_attendance_students class_period_attendance_students[]
  fee_payments                     fee_payments[]
  fee_receipts                     fee_receipts[]
  student_enrollments              student_enrollments[]
  student_fees                     student_fees[]
  student_guardians                student_guardians[]
  student_marks                    student_marks[]
  student_profiles                 student_profiles?
  student_consents                 StudentConsent[]
  parent_student_links             ParentStudentLink[]
}

model Invoice {
  id          String   @id @default(cuid())
  tenantId    String
  amount      Float
  studentName String
  status      String   @default("PENDING")
  dueDate     String   @default("")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Payment {
  id                 String    @id @default(cuid())
  tenantId           String
  amount             Float
  studentName        String
  status             String    @default("SUCCESS")
  createdAt          DateTime  @default(now())
  transactionId      String?
  paymentMethod      String?
  plan               String?
  verificationStatus String    @default("PENDING")
  verifiedAt         DateTime? @db.Timestamp(6)
  verifiedBy         String?
  notes              String?
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  tenantId   String
  senderName String
  senderRole String
  content    String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  userRole     String
  action       String
  resourceType String
  resourceId   String
  allowed      Boolean
  errorCode    String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model BusLocation {
  id        String   @id @default(cuid())
  tenantId  String
  busNumber String   @default("Bus #4 (Route A)")
  latitude  Float    @default(28.6139)
  longitude Float    @default(77.2090)
  speed     String   @default("42 km/h")
  status    String   @default("On Time")
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Attendance {
  id          String   @id @default(cuid())
  tenantId    String
  studentName String   @default("Rahul Gupta")
  date        String   @default("2026-08-24")
  status      String   @default("PRESENT")
  punchTime   String   @default("08:15 AM")
  createdAt   DateTime @default(now())
  studentId   String?
  Student     Student? @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, date])
}

model Lead {
  id          String   @id @default(cuid())
  contactName String   @default("")
  schoolName  String   @default("")
  email       String   @default("")
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}

model Staff {
  id                 String               @id @default(cuid())
  name               String               @default("")
  role               String               @default("Teacher")
  email              String               @default("")
  createdAt          DateTime             @default(now())
  employee_id        String?
  first_name         String?
  last_name          String?
  phone              String?
  gender             String?
  designation        String?
  department         String?
  status             String               @default("ACTIVE")
  salutation         String?              @default("Mr")
  tenantId           String?
  teacher_attendance teacher_attendance[]

  @@index([employee_id])
  @@index([role])
  @@index([status])
}

model Exam {
  id        String   @id @default(cuid())
  title     String   @default("")
  subject   String   @default("")
  date      String   @default("")
  createdAt DateTime @default(now())
}

model LibraryAsset {
  id        String   @id @default(cuid())
  title     String   @default("")
  author    String   @default("")
  status    String   @default("AVAILABLE")
  createdAt DateTime @default(now())
}

model EnergyLog {
  id        String   @id @default(cuid())
  reading   Float    @default(0)
  cost      Float    @default(0)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String   @default("")
  content   String   @default("")
  createdAt DateTime @default(now())
}

model BackupSnapshot {
  id        String   @id @default(cuid())
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
}

model School {
  id        String   @id @default(cuid())
  name      String   @default("")
  subdomain String   @unique @default("")
  plan      String   @default("standard")
  createdAt DateTime @default(now())
}

model SmartAccreditationHub {
  id        String   @id @default(cuid())
  standard  String   @default("")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AdmissionDecision {
  id            String    @id @default(dbgenerated("('decision_'::text || (gen_random_uuid())::text)"))
  applicationId String
  decision      String
  decidedAt     DateTime? @default(now()) @db.Timestamp(6)
  decidedBy     String?
  reason        String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)

  @@index([applicationId], map: "idx_admission_decision_application")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AdmissionEnquiry {
  id               String    @id @default(dbgenerated("('enquiry_'::text || (gen_random_uuid())::text)"))
  leadId           String?
  tenantId         String?
  studentName      String
  parentName       String?
  parentEmail      String?
  parentPhone      String?
  dateOfBirth      DateTime? @db.Date
  gender           String?
  gradeApplyingFor String?
  academicYear     String?
  source           String?   @default("CRM")
  status           String    @default("NEW")
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @db.Timestamp(6)

  @@index([leadId], map: "idx_admission_enquiry_lead")
  @@index([status], map: "idx_admission_enquiry_status")
  @@index([tenantId], map: "idx_admission_enquiry_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Applicant {
  id           String    @id @default(dbgenerated("('applicant_'::text || (gen_random_uuid())::text)"))
  enquiryId    String?
  tenantId     String?
  firstName    String
  middleName   String?
  lastName     String?
  dateOfBirth  DateTime? @db.Date
  gender       String?
  parentName   String?
  parentEmail  String?
  parentPhone  String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?   @default("India")
  postalCode   String?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @db.Timestamp(6)

  @@index([enquiryId], map: "idx_applicant_enquiry")
  @@index([tenantId], map: "idx_applicant_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Application {
  id                String    @id @default(dbgenerated("('application_'::text || (gen_random_uuid())::text)"))
  applicantId       String
  tenantId          String?
  applicationNumber String?   @unique
  academicYear      String
  gradeApplyingFor  String
  status            String    @default("SUBMITTED")
  submittedAt       DateTime? @default(now()) @db.Timestamp(6)
  notes             String?
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  updatedAt         DateTime  @default(now()) @db.Timestamp(6)

  @@index([applicantId], map: "idx_application_applicant")
  @@index([status], map: "idx_application_status")
  @@index([tenantId], map: "idx_application_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ApplicationDocument {
  id            String    @id @default(dbgenerated("('document_'::text || (gen_random_uuid())::text)"))
  applicationId String
  documentType  String
  fileName      String?
  fileUrl       String?
  status        String    @default("PENDING")
  verifiedAt    DateTime? @db.Timestamp(6)
  verifiedBy    String?
  notes         String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @db.Timestamp(6)

  @@index([applicationId], map: "idx_application_document_application")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Assessment {
  id             String    @id @default(dbgenerated("('assessment_'::text || (gen_random_uuid())::text)"))
  applicationId  String
  assessmentType String
  scheduledAt    DateTime? @db.Timestamp(6)
  status         String    @default("SCHEDULED")
  score          Decimal?  @db.Decimal
