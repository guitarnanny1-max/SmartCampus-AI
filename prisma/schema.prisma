datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id           String        @id @default(cuid())
  subdomain    String        @unique
  name         String
  createdAt    DateTime      @default(now())
  payments     Payment[]
  messages     Message[]
  busLocations BusLocation[]
  attendances  Attendance[]
  users        User[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  name      String
  role      String
  password  String
  createdAt DateTime @default(now())
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Float
  studentName String
  status      String   @default("SUCCESS")
  createdAt   DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  tenantId   String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senderName String
  senderRole String
  content    String
  createdAt  DateTime @default(now())
}

model BusLocation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  busNumber String   @default("Bus #4 (Route A)")
  latitude  Float    @default(28.6139)
  longitude Float    @default(77.2090)
  speed     String   @default("42 km/h")
  status    String   @default("On Time - 8 mins to Campus")
  updatedAt DateTime @updatedAt
}

model Attendance {
  id          String   @id @default(cuid())
  tenantId    String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentName String   @default("Rahul Gupta")
  date        String   @default("2026-08-24")
  status      String   @default("PRESENT")
  punchTime   String   @default("08:15 AM")
  createdAt   DateTime @default(now())
}
