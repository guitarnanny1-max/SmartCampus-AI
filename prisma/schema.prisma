/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PlatformCustomBill {
  id          String    @id
  tenantId    String
  description String
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime? @db.Date
  status      String    @default("PENDING")
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  Tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PlatformPlan {
  id                    String         @id
  name                  String         @unique
  monthlyPrice          Decimal?       @db.Decimal(12, 2)
  annualPrice           Decimal?       @db.Decimal(12, 2)
  studentLimit          Int?
  teacherLimit          Int?
  razorpayMonthlyPlanId String?
  razorpayAnnualPlanId  String?
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @db.Timestamptz(6)
  Subscription          Subscription[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PlatformSettings {
  id                    String   @id
  platformName          String   @default("SmartCampusAI")
  supportEmail          String?
  supportPhone          String?
  currency              String   @default("INR")
  timezone              String   @default("Asia/Kolkata")
  maintenanceMode       Boolean  @default(false)
  schoolCreationEnabled Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Subscription {
  id                     String       @id
  tenantId               String
  planId                 String
  status                 String       @default("ACTIVE")
  billingCycle           String       @default("MONTHLY")
  startedAt              DateTime     @default(now()) @db.Timestamptz(6)
  currentPeriodStart     DateTime     @default(now()) @db.Timestamptz(6)
  currentPeriodEnd       DateTime?    @db.Timestamptz(6)
  canceledAt             DateTime?    @db.Timestamptz(6)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?      @unique
  razorpayPlanId         String?
  createdAt              DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @db.Timestamptz(6)
  PlatformPlan           PlatformPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
