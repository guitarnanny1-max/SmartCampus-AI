/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Interview {
  id              String    @id @default(dbgenerated("('interview_'::text || (gen_random_uuid())::text)"))
  applicationId   String
  scheduledAt     DateTime? @db.Timestamp(6)
  interviewerName String?
  mode            String?   @default("IN_PERSON")
  status          String    @default("SCHEDULED")
  score           Decimal?  @db.Decimal
  feedback        String?
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @db.Timestamp(6)

  @@index([applicationId], map: "idx_interview_application")
