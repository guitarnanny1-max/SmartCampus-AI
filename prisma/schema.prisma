generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  energyLogs         EnergyLog[]
  libraryAssets      LibraryAsset[]
  exams              Exam[]
  applicants         Applicant[]
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique
  subdomain          String              @unique
  subscriptionStatus String              @default("ACTIVE")
  subscriptionTier   String              @default("ENTERPRISE")
  primaryColor       String              @default("#0f172a")
  students           Student[]
  facilities         Facility[]
  tickets            MaintenanceTicket[]
  staff              Staff[]
  fees               Invoice[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Facility {
  id          String              @id @default(cuid())
  name        String
  type        String
  schoolId    String
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tickets     MaintenanceTicket[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model MaintenanceTicket {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Student {
  id        String   @id @default(cuid())
  studentId String   @unique
  name      String
  grade     String
  email     String   @unique
  status    String   @default("Active")
  gpa       Float?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Staff {
  id         String   @id @default(cuid())
  staffId    String   @unique
  name       String
  department String
  role       String
  email      String   @unique
  status     String   @default("Active")
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model LibraryBook {
  id         String   @id @default(cuid())
  bookId     String   @unique
  title      String
  author     String
  category   String
  status     String   @default("Available")
  borrower   String?
  createdAt  DateTime @default(now())
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceId   String   @unique
  studentName String
  grade       String
  amount      Float
  status      String   @default("Pending")
  dueDate     DateTime
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Applicant {
  id           String   @id @default(cuid())
  applicantId  String   @unique
  name         String
  email        String   @unique
  gradeApplied String
  status       String   @default("Reviewing")
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Exam {
  id          String   @id @default(cuid())
  examId      String   @unique
  title       String
  subject     String
  grade       String
  date        DateTime
  maxMarks    Int      @default(100)
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model LibraryAsset {
  id          String   @id @default(cuid())
  assetId     String   @unique
  title       String
  category    String   
  status      String   @default("Available")
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model EnergyLog {
  id          String   @id @default(cuid())
  location    String
  powerKwh    Float
  status      String   @default("Optimal")
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
